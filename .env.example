# Copy this file to ".env.local" and fill in the values.
# Never share or commit ".env.local": it holds passwords.
#
# IMPORTANT: put a value in "double quotes" if it contains # or spaces.
# Without quotes, everything from the # onwards is silently dropped.

# ---------------------------------------------------------------------------
# Database (PostgreSQL) for the admin panel: articles, blog, images, site text
# ---------------------------------------------------------------------------
# Create an empty database called "enerdi-db" first. The tables are created
# automatically the first time the site runs.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=""
PGDATABASE=enerdi-db

# Later, for Supabase (or any hosted Postgres): paste its connection string
# here. When DATABASE_URL is set, the five PG... lines above are ignored.
# In Supabase: Connect > Connection string > "Transaction pooler" (or "Session
# pooler"). If the password has special characters, they must be URL-encoded
# in this address (# becomes %23, @ becomes %40, / becomes %2F, a space %20).
# DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xxxx.pooler.supabase.com:6543/postgres"

# Recommended in production: the provider's CA certificate, so the database
# server is verified and not just encrypted. In Supabase: Project Settings >
# Database > SSL Configuration > download the certificate, then paste the
# whole text here on one line with \n where the line breaks were.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ---------------------------------------------------------------------------
# Admin panel (/admin)
# ---------------------------------------------------------------------------
# The first admin account is created from these two the first time someone
# signs in. After that the password is changed from Admin > Account, and
# editing ADMIN_PASSWORD here does nothing.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=""

# A long random secret that signs the admin login cookie (32+ characters).
# Changing it signs everyone out.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Contact form
# ---------------------------------------------------------------------------

# Where contact form enquiries are delivered.
CONTACT_TO=you@example.com

# The Gmail account the website sends from (a full email address).
SMTP_USER=you@example.com

# A Gmail "app password" for that account (16 letters, not the normal password).
# Create one at https://myaccount.google.com/apppasswords
# (2-Step Verification must be switched on for the account first).
SMTP_PASSWORD=

# Only change these if you stop using Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Optional. The public address of the site, e.g. https://www.enerdi.com
# Shown as a button in the confirmation email and used for link previews.
SITE_URL=

# Optional. Timezone for the "Received" time in the enquiry email.
CONTACT_TIMEZONE=Asia/Kolkata
